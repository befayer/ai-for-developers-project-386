{
  "name": "call-calendar",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Сервис бронирования звонков — учебный проект Хекслета",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run api:generate && tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "node scripts/api-generate.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@typespec/ts-http-runtime": "^0.2.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "uri-template": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typespec/compiler": "^1.16.0",
    "@typespec/events": "^0.86.0",
    "@typespec/http": "^1.16.0",
    "@typespec/http-client-js": "^0.16.2",
    "@typespec/json-schema": "^1.16.0",
    "@typespec/openapi": "^1.16.0",
    "@typespec/openapi3": "^1.16.0",
    "@typespec/rest": "^0.86.0",
    "@typespec/sse": "^0.86.0",
    "@typespec/streams": "^0.86.0",
    "@typespec/versioning": "^0.86.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
